diff --git a/private_dot_config/rspb/env.sh b/private_dot_config/rspb/env.sh
new file mode 100644
index 0000000..3359bd3
--- /dev/null
+++ b/private_dot_config/rspb/env.sh
@@ -0,0 +1,13 @@
+# shellcheck shell=sh
+# Sourced by both .profile and .bashrc.
+for rspb_path in "${CARGO_HOME:-$HOME/.cargo}/bin" "$HOME/.local/bin"; do
+    case ":$PATH:" in
+        *:"$rspb_path":*) ;;
+        *) PATH="$rspb_path:$PATH" ;;
+    esac
+done
+export PATH
+unset rspb_path
+if [ -n "${BASH_VERSION:-}" ] && command -v fnm >/dev/null 2>&1; then
+    eval "$(fnm env --use-on-cd --shell bash)"
+fi
